<?xml version="1.0" encoding="utf-8"?>
<!-- Screen underneath shifts left a little and dims, like iOS navigation -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="400"
    android:interpolator="@interpolator/ease_drawer">
    <translate android:fromXDelta="0" android:toXDelta="-25%" />
    <alpha android:fromAlpha="1" android:toAlpha="0.85" />
</set>
