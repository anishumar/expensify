<?xml version="1.0" encoding="utf-8"?>
<!-- Mirror of push_exit: the screen underneath comes back from where it went -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="400"
    android:interpolator="@interpolator/ease_drawer">
    <translate android:fromXDelta="-25%" android:toXDelta="0" />
    <alpha android:fromAlpha="0.85" android:toAlpha="1" />
</set>
