<resources>
    <color name="brand">#0F766E</color>
    <color name="brand_dark">#115E59</color>
    <color name="bg">#F6F7F9</color>
    <color name="card">#FFFFFF</color>
    <color name="text">#111827</color>
    <color name="muted">#6B7280</color>
    <color name="track">#E5E7EB</color>

    <style name="Theme.Kharcha" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/brand</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/brand_dark</item>
    </style>

    <style name="SectionTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
