<resources>
    <!-- Black on white, one red accent -->
    <color name="ink">#000000</color>
    <color name="paper">#FFFFFF</color>
    <color name="muted">#8C000000</color>
    <color name="faint">#4D000000</color>
    <color name="hairline">#14000000</color>
    <color name="fill">#0A000000</color>
    <color name="accent">#FF3B30</color>

    <!-- launcher icon background -->
    <color name="brand">#000000</color>

    <style name="Theme.Kharcha" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/ink</item>
        <item name="colorOnPrimary">@color/paper</item>
        <item name="colorPrimaryContainer">@color/ink</item>
        <item name="colorOnPrimaryContainer">@color/paper</item>
        <item name="colorSecondary">@color/ink</item>
        <item name="colorOnSecondary">@color/paper</item>
        <item name="colorSecondaryContainer">@color/ink</item>
        <item name="colorOnSecondaryContainer">@color/paper</item>
        <item name="colorSurface">@color/paper</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorSurfaceVariant">@color/fill</item>
        <item name="colorOutline">@color/hairline</item>
        <item name="colorControlNormal">@color/ink</item>
        <item name="colorError">@color/accent</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>
    </style>

    <!-- Launch: the money bag on white, then the app theme -->
    <style name="Theme.Kharcha.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/paper</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_bag</item>
        <item name="postSplashScreenTheme">@style/Theme.Kharcha</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Section heading, like iOS Title 2: weight carries the hierarchy, tight tracking -->
    <style name="SectionTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">44dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">22sp</item>
        <item name="android:letterSpacing">-0.009</item>
        <item name="android:fontFamily">@font/inter_display_semibold</item>
    </style>

    <style name="IconButton">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:padding">10dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">fitCenter</item>
    </style>
</resources>
